{
  "name": "website-council",
  "version": "1.0.0",
  "private": true,
  "description": "Council at council.profitriseco.com. Cloudflare staging, AWS production, and a private local Roast Room runner.",
  "type": "module",
  "scripts": {
    "start": "node app/server.mjs",
    "smoke": "node app/scripts/smoke.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --test tests/*.test.mjs",
    "test": "npm run check && playwright test",
    "preview": "node scripts/serve.mjs",
    "start:service": "node service/server.mjs",
    "deploy:staging": "wrangler pages deploy dist --project-name website-council-staging --branch main",
    "deploy:production": "node scripts/backend-handoff.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.0",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "jose": "6.2.1"
  }
}
